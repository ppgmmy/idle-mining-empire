{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/daily-opt-cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/daily-opt-cron",
      "schedule": "0 9 * * *"
    }
  ]
}
